{
  "name": "matthew-gaksch-portfolio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-version.mjs && next dev -p 5173",
    "blog:editor": "node studio/server.mjs",
    "prebuild": "node studio/blog-images.mjs && node studio/profile-images.mjs",
    "build": "node scripts/build-version.mjs && next build",
    "cloudflare:preview": "node scripts/build-version.mjs && wrangler dev --local",
    "cloudflare:deploy": "node scripts/build-version.mjs && wrangler deploy",
    "start": "npm run cloudflare:preview",
    "typecheck": "node scripts/build-version.mjs && npm run worker:types && tsc --noEmit --pretty false",
    "lint": "eslint .",
    "prepare:version": "node scripts/build-version.mjs",
    "test:version": "node --test scripts/build-version.test.mjs",
    "worker:types": "wrangler types",
    "test:contributions": "node --test scripts/github-contributions.test.mjs",
    "postbuild": "node scripts/security-headers.mjs && node scripts/check-release.mjs",
    "test:security": "node --test tests/security.test.mjs tests/blog-schema.test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:version && npm run test:contributions && npm run test:security && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "next": "^16.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^16.33.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "wrangler": "^4.143.0"
  },
  "overrides": {
    "undici": "^7.30.1",
    "hono": "^4.13.11",
    "@hono/node-server": "^1.19.15",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "basic-ftp": "^6.1.0",
    "body-parser": "^2.4.0",
    "fast-uri": "^3.1.9",
    "ip-address": "^10.7.4",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "zod": "4.6.6"
  },
  "engines": {
    "node": "^24.22.1"
  }
}
