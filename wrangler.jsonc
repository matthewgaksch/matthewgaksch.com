{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "matthewgaksch-com",
  "compatibility_date": "2026-09-29",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/version",
      "/api/version/"
    ]
  },
  "routes": [
    {
      "pattern": "matthewgaksch.com",
      "custom_domain": true
    }
  ],
  "main": "worker/index.ts",
  "account_id": "16cf2e7b99f9618cd5506672b02308ee",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0
    }
  }
}
